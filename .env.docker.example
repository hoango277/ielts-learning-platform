# Cấu hình khi chạy bằng Docker Compose: sao chép file này thành .env (cùng thư mục với docker-compose.yml).
# Mọi biến đều tuỳ chọn — bỏ trống thì dùng giá trị mặc định ghi bên cạnh.

# Phiên bản image trên Docker Hub (xuanhoa2772004/ielts-learn) — mặc định: latest
IELTS_TAG=latest
# Cổng mở trên máy chủ — mặc định: 4000 (mở http://localhost:4000)
IELTS_PORT=4000

# Múi giờ: quyết định "hôm nay", chuỗi ngày học và giờ gửi nhắc ôn (8h–22h)
TZ=Asia/Ho_Chi_Minh

# Cho phép tạo thêm tài khoản sau tài khoản đầu tiên. Chỉ mình bạn dùng → đặt false sau khi đã tạo tài khoản.
ALLOW_REGISTRATION=true

# Quốc gia cho kết quả YouTube (gợi ý, tìm kiếm)
YT_LOCATION=US

# Thông báo đẩy (Web Push). Bỏ trống khoá → app tự tạo một lần và lưu trong dữ liệu (volume /data).
# Nên đặt VAPID_SUBJECT là email thật của bạn (Apple/Safari từ chối địa chỉ mặc định).
VAPID_SUBJECT=mailto:ban@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Bao lâu kiểm tra thẻ sắp quên một lần (phút); 0 = tắt nhắc nhở từ máy chủ
PUSH_CHECK_MINUTES=15

# Chỉ dùng khi chạy kèm docker-compose.hymt.yml: thư mục chứa sẵn file model Hy-MT (bỏ trống = tự tải ~1,1 GB vào volume)
# HYMT_MODELS=./tools/llm
