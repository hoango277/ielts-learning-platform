{
  "name": "@ielts-learn/backend",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "node --disable-warning=ExperimentalWarning src/index.ts",
    "crawl": "tsx src/crawler/crawl-topics.ts",
    "seed": "tsx src/db/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "ts-fsrs": "^5.4.2",
    "web-push": "^3.6.7",
    "wordnet-db": "^3.1.14",
    "youtubei.js": "^18.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
