# Sao chép thành backend/.env nếu muốn thay đổi mặc định (mọi biến đều tuỳ chọn)

# Cổng & địa chỉ của API (frontend dev ở 5173 sẽ proxy /api sang đây)
PORT=4000
HOST=127.0.0.1

# Vị trí file SQLite (tương đối với thư mục backend)
# DB_PATH=data/ielts-learn.db

# Nguồn gốc được phép gọi API khi chạy frontend dev
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Quốc gia dùng cho kết quả YouTube (ảnh hưởng gợi ý/tìm kiếm)
YT_LOCATION=US

# Nhà cung cấp dịch mặc định: auto | google | hymt (có thể đổi trong trang Cài đặt)
TRANSLATE_PROVIDER=auto

# --- Tencent Hunyuan Hy-MT qua server tương thích OpenAI (có thể cấu hình trong trang Cài đặt) ---
# Ollama:    HYMT_BASE_URL=http://localhost:11434/v1   HYMT_MODEL=hf.co/tencent/HY-MT1.5-1.8B-GGUF:Q8_0
# llama.cpp: HYMT_BASE_URL=http://localhost:8080/v1    HYMT_MODEL=hy-mt
# vLLM:      HYMT_BASE_URL=http://localhost:8000/v1    HYMT_MODEL=tencent/Hy-MT2-7B
HYMT_BASE_URL=
HYMT_MODEL=
HYMT_API_KEY=
# hymt2 (Hy-MT2, mặc định) hoặc hymt15 (HY-MT1.5) — chọn đúng mẫu prompt theo model
HYMT_PROMPT_STYLE=hymt2

# Cho phép đăng ký thêm tài khoản (tài khoản đầu tiên luôn tạo được). Đặt false khi chỉ mình bạn dùng.
ALLOW_REGISTRATION=true
