# Sao chép thành backend/.env nếu muốn thay đổi mặc định (mọi biến đều tuỳ chọn)

# Cổng & địa chỉ của API (frontend dev ở 5173 sẽ proxy /api sang đây)
PORT=4000
HOST=127.0.0.1

# Vị trí file SQLite (tương đối với thư mục backend)
# DB_PATH=data/ielts-learn.db

# Nguồn gốc được phép gọi API khi chạy frontend dev
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Quốc gia dùng cho kết quả YouTube (ảnh hưởng gợi ý/tìm kiếm)
YT_LOCATION=US

# Nhà cung cấp dịch mặc định: auto | google | hymt (admin đổi được trong trang Quản trị)
TRANSLATE_PROVIDER=auto

# --- Tencent Hunyuan Hy-MT qua server tương thích OpenAI — giá trị mặc định, admin đổi được trong trang Quản trị ---
# Ollama:    HYMT_BASE_URL=http://localhost:11434/v1   HYMT_MODEL=hf.co/tencent/HY-MT1.5-1.8B-GGUF:Q8_0
# llama.cpp: HYMT_BASE_URL=http://localhost:8080/v1    HYMT_MODEL=hy-mt
# vLLM:      HYMT_BASE_URL=http://localhost:8000/v1    HYMT_MODEL=tencent/Hy-MT2-7B
HYMT_BASE_URL=
HYMT_MODEL=
HYMT_API_KEY=
# hymt2 (Hy-MT2, mặc định) hoặc hymt15 (HY-MT1.5) — chọn đúng mẫu prompt theo model
HYMT_PROMPT_STYLE=hymt2

# Cho phép đăng ký thêm tài khoản (mặc định; admin bật/tắt lại được trong trang Quản trị).
# Tài khoản đầu tiên luôn tạo được và là quản trị viên (admin); các tài khoản sau là học viên.
ALLOW_REGISTRATION=true

# --- Thông báo đẩy (Web Push) nhắc ôn thẻ sắp quên, kể cả khi đã đóng tab ---
# Bỏ trống khoá → app tự tạo cặp khoá VAPID một lần và lưu trong DB (bảng app_kv).
# Tự tạo khoá: npx web-push generate-vapid-keys
# VAPID_SUBJECT nên là email thật (Apple/Safari từ chối địa chỉ mặc định).
VAPID_SUBJECT=mailto:ban@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Chu kỳ kiểm tra để gửi nhắc (phút); 0 = tắt. Chỉ gửi 8h–22h theo giờ máy chủ, tối đa 2 lần/ngày.
PUSH_CHECK_MINUTES=15

# Múi giờ của máy chủ quyết định "hôm nay", chuỗi ngày học và giờ gửi nhắc. Ví dụ: TZ=Asia/Ho_Chi_Minh
# TZ=Asia/Ho_Chi_Minh
